# ─────────────────────────────────────────────────────────────
#  Weather App 2026 — .gitignore
# ─────────────────────────────────────────────────────────────

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE / editor files
.vscode/
.idea/
*.suo
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
